# Required. Replace both values before starting the service.
ADMIN_PASSWORD=replace-with-a-long-unique-password

# Required. Random string used to sign session cookies.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=replace-with-output-of-python-secrets-token_urlsafe-48

# Optional. Public domain used by Caddy for automatic TLS.
DOMAIN=events.example.com

# Optional. Host port (used by docker-compose.proxy.yml only).
APP_PORT=8000

# Optional. Image tag managed by scripts/deploy.sh.
IMAGE_TAG=local

# Optional. Display timezone.
TZ=Asia/Taipei
